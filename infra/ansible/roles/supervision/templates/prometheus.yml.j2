# {{ ansible_managed }}
global:
  scrape_interval: 30s
  evaluation_interval: 30s

# Règles du rôle, puis règles supplémentaires (supervision_regles_supplementaires).
rule_files: [/etc/prometheus/alertes.yml, /etc/prometheus/regles-*.yml]

alerting:
  alertmanagers:
    - static_configs: [{ targets: ["alertmanager:9093"] }]

# Libellé « instance » = nom court de la machine (hv01, waf01…) plutôt que nom:port.
{% set nom_court = [{'source_labels': ['__address__'], 'regex': '([^.:]+).*', 'target_label': 'instance', 'replacement': '$1'}] %}
scrape_configs:
  - job_name: machines
    static_configs:
      - targets:
{% for h in (groups['hyperviseurs'] + groups['plateforme'] + supervision_machines_supplementaires) | unique | sort %}
          - "{{ h }}.{{ domaine_interne }}:9100"
{% endfor %}
    relabel_configs: {{ nom_court | to_json }}

  - job_name: disques
    static_configs:
      - targets:
{% for h in groups['hyperviseurs'] %}
          - "{{ h }}.{{ domaine_interne }}:9633"
{% endfor %}
    relabel_configs: {{ nom_court | to_json }}

  - job_name: proxmox
    metrics_path: /pve
    params: { module: [default], cluster: ["1"], node: ["1"] }
    static_configs:
      - targets:
{% for h in groups['hyperviseurs'] %}
          - "{{ h }}.{{ domaine_interne }}"
{% endfor %}
    relabel_configs:
      - { source_labels: [__address__], target_label: __param_target }
      - { source_labels: [__param_target], regex: '([^.]+).*', target_label: instance, replacement: '$1' }
      - { target_label: __address__, replacement: "pve:9221" }

  # Services publiés : sondés via le WAF (résolution interne), avec contrôle du certificat. Les sites protégés par
  # le SSO du WAF sont sondés sans suivre la redirection : la sonde vérifie que la barrière est bien en place.
  - job_name: services
    metrics_path: /probe
    static_configs:
      - targets: {{ supervision_services_publics | to_json }}
        labels: { module: https }
{% if supervision_services_sso | length > 0 %}
      - targets: {{ supervision_services_sso | to_json }}
        labels: { module: sso }
{% endif %}
    relabel_configs:
      - { source_labels: [module], target_label: __param_module }
      # Libellé retiré ensuite : mêmes séries qu'avant (historique de disponibilité du NOC conservé).
      - { regex: module, action: labeldrop }
      - { source_labels: [__address__], target_label: __param_target }
      - { source_labels: [__param_target], regex: 'https://([^/]+).*', target_label: instance, replacement: '$1' }
      - { target_label: __address__, replacement: "blackbox:9115" }

  - job_name: outils-internes
    metrics_path: /probe
    params: { module: [https] }
    static_configs:
      - targets: {{ supervision_outils_internes | to_json }}
    relabel_configs:
      - { source_labels: [__address__], target_label: __param_target }
      - { source_labels: [__param_target], regex: 'https://([^/:]+).*', target_label: instance, replacement: '$1' }
      - { target_label: __address__, replacement: "blackbox:9115" }

  - job_name: ping
    metrics_path: /probe
    params: { module: [icmp] }
    static_configs:
      - targets:
{% for h in (groups['hyperviseurs'] + groups['plateforme'] + supervision_machines_supplementaires) | unique | sort %}
          - "{{ h }}.{{ domaine_interne }}"
{% endfor %}
    relabel_configs:
      - { source_labels: [__address__], target_label: __param_target }
      - { source_labels: [__param_target], regex: '([^.]+).*', target_label: instance, replacement: '$1' }
      - { target_label: __address__, replacement: "blackbox:9115" }

  - job_name: supervision
    static_configs:
      - targets: ["localhost:9090", "alertmanager:9093"{% if supervision_journaux | bool %}, "victorialogs:9428"{% if supervision_detection | bool %}, "vmalert:8880"{% endif %}{% endif %}]
{% if supervision_veille | bool %}

  # Veille de sécurité : résultats de la dernière analyse (une par nuit), servis par le conteneur « veille ».
  - job_name: veille
    scrape_interval: 5m
    static_configs:
      - targets: ["veille:9800"]
{% endif %}
{% if supervision_connexions | bool %}

  # Veille des connexions : adresses connues, tentatives depuis une adresse inconnue.
  - job_name: connexions
    static_configs:
      - targets: ["connexions:9801"]
{% endif %}
