# {{ ansible_managed }}
# Alertes critiques : e-mail + notification sur téléphone (ntfy){% if supervision_sms_free.cle is defined %} + SMS (Free Mobile){% endif %}.
# Avertissements : affichés sur le NOC seulement. « admin » : e-mail + téléphone, hors NOC (sujets réservés à
# l'administrateur).
global:
  smtp_smarthost: "{{ supervision_smtp.serveur }}:587"
  smtp_from: "Supervision homelab <{{ supervision_smtp.expediteur }}>"
  smtp_auth_username: "{{ supervision_smtp.utilisateur }}"
  smtp_auth_password_file: /etc/alertmanager/secrets/smtp
  smtp_require_tls: true

route:
  receiver: noc
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 6h
  routes:
    - matchers: ['severite="critique"']
      receiver: critique
    # Veille de sécurité et mises à jour : un message par type d'alerte (liste des services concernés), rappel
    # chaque semaine tant que rien n'est fait, puis « résolu ». Ni SMS ni NOC.
    # Détection d'intrusion : chaque machine à part, notification prioritaire, rappel toutes les 12 h. Pas de SMS.
    - matchers: ['severite="securite"']
      receiver: securite
      group_by: [alertname, instance]
      group_wait: 30s
      repeat_interval: 12h
    # Information (ex. un long travail terminé) : notification discrète sur le téléphone seulement.
    - matchers: ['severite="info"']
      receiver: info
      group_by: [alertname, travail]
      group_wait: 30s
      repeat_interval: 24h
    - matchers: ['severite="admin"']
      receiver: admin
      group_by: [alertname, instance]
      group_wait: 1m
      repeat_interval: 12h
    - matchers: ['severite="veille"']
      receiver: veille
      group_by: [alertname]
      group_wait: 10m
      group_interval: 6h
      repeat_interval: 168h

receivers:
  - name: noc
  - name: critique
    email_configs:
      - to: "{{ supervision_email_alertes }}"
        send_resolved: true
        headers:
          Subject: '{{ '{{' }} if eq .Status "firing" {{ '}}' }}[ALERTE]{{ '{{' }} else {{ '}}' }}[RÉSOLU]{{ '{{' }} end {{ '}}' }} {{ '{{' }} .CommonLabels.alertname {{ '}}' }} — {{ '{{' }} .CommonLabels.instance {{ '}}' }}'
    webhook_configs:
      # Relais « ntfy-relais » : message mis en forme en français, plusieurs essais (le modèle intégré à ntfy a un
      # délai de 100 ms, parfois dépassé ici : notifications perdues le 29/09).
      - url: "http://ntfy-relais:8080/alertmanager?priorite=high&prefixe=ALERTE"
        send_resolved: true
{% if supervision_sms_free.cle is defined %}
      # SMS au titulaire de la ligne Free Mobile (relais « sms » de la pile).
      - url: "http://sms:8080/alertmanager"
        send_resolved: true
{% endif %}

  - name: veille
    email_configs:
      - to: "{{ supervision_email_alertes }}"
        send_resolved: true
        headers:
          Subject: '{{ '{{' }} if eq .Status "firing" {{ '}}' }}[VEILLE]{{ '{{' }} else {{ '}}' }}[FAIT]{{ '{{' }} end {{ '}}' }} {{ '{{' }} .CommonLabels.alertname {{ '}}' }} ({{ '{{' }} len .Alerts.Firing {{ '}}' }})'
    webhook_configs:
      # Relais « ntfy-relais » : message mis en forme en français, plusieurs essais (le modèle intégré à ntfy a un
      # délai de 100 ms, parfois dépassé ici : notifications perdues le 29/09).
      - url: "http://ntfy-relais:8080/alertmanager?priorite=default&prefixe=VEILLE"
        send_resolved: false

  - name: securite
    email_configs:
      - to: "{{ supervision_email_alertes }}"
        send_resolved: true
        headers:
          Subject: '{{ '{{' }} if eq .Status "firing" {{ '}}' }}[SÉCURITÉ]{{ '{{' }} else {{ '}}' }}[FIN]{{ '{{' }} end {{ '}}' }} {{ '{{' }} .CommonLabels.alertname {{ '}}' }} — {{ '{{' }} .CommonLabels.instance {{ '}}' }}'
    webhook_configs:
      # Relais « ntfy-relais » : message mis en forme en français, plusieurs essais (le modèle intégré à ntfy a un
      # délai de 100 ms, parfois dépassé ici : notifications perdues le 29/09).
      - url: "http://ntfy-relais:8080/alertmanager?priorite=high&prefixe=SECURITE"
        send_resolved: false

  - name: admin
    email_configs:
      - to: "{{ supervision_email_alertes }}"
        send_resolved: true
        headers:
          Subject: '{{ '{{' }} if eq .Status "firing" {{ '}}' }}[ADMIN]{{ '{{' }} else {{ '}}' }}[RÉSOLU]{{ '{{' }} end {{ '}}' }} {{ '{{' }} .CommonLabels.alertname {{ '}}' }} — {{ '{{' }} .CommonLabels.instance {{ '}}' }}'
    webhook_configs:
      - url: "http://ntfy-relais:8080/alertmanager?priorite=default&prefixe=ADMIN"
        send_resolved: true

  - name: info
    webhook_configs:
      - url: "http://ntfy-relais:8080/alertmanager?priorite=low&prefixe=INFO"
        send_resolved: false

# Une alerte critique masque l'avertissement équivalent sur la même machine.
inhibit_rules:
  - source_matchers: ['severite="critique"']
    target_matchers: ['severite="avertissement"']
    equal: [instance]
