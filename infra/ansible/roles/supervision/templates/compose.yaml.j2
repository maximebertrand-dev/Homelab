# {{ ansible_managed }}
# Supervision : Prometheus (métriques, règles d'alerte), Alertmanager (e-mail + ntfy), sondes blackbox,
# état de Proxmox, Grafana (NOC public, SSO obligatoire) et ntfy (notifications sur téléphone).
name: supervision

services:
  prometheus:
    image: {{ supervision_images.prometheus }}
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ supervision_retention }}
      - --web.external-url=https://prometheus.{{ domaine_interne }}
    ports: ["9090:9090"]   # proxy interne uniquement (filtré par OPNsense)
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prometheus:/prometheus
    security_opt: ["no-new-privileges:true"]

  alertmanager:
    image: {{ supervision_images.alertmanager }}
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      # Notifications gardées 10 jours : le rappel hebdomadaire des alertes « veille » s'appuie dessus.
      - --data.retention=240h
      - --web.external-url=https://alertmanager.{{ domaine_interne }}
    ports: ["9093:9093"]   # proxy interne uniquement
    volumes:
      - ./alertmanager:/etc/alertmanager:ro
      - alertmanager:/alertmanager
    security_opt: ["no-new-privileges:true"]

  blackbox:
    image: {{ supervision_images.blackbox }}
    restart: unless-stopped
    command: ["--config.file=/etc/blackbox/blackbox.yml"]
    volumes:
      - ./blackbox.yml:/etc/blackbox/blackbox.yml:ro
      - ./autorites.pem:/etc/blackbox/autorites.pem:ro
    cap_add: [NET_RAW]   # sondes ping (ICMP)
    security_opt: ["no-new-privileges:true"]

  pve:
    image: {{ supervision_images.pve }}
    restart: unless-stopped
    command: ["--config.file", "/etc/prometheus/pve.yml"]
    environment:
      # Le certificat de Proxmox est signé par son autorité interne : seule cette autorité est acceptée.
      REQUESTS_CA_BUNDLE: /etc/ssl/homelab/ca-bundle.pem
    volumes:
      - ./secrets/pve.yml:/etc/prometheus/pve.yml:ro
      - ./ca-bundle.pem:/etc/ssl/homelab/ca-bundle.pem:ro
    security_opt: ["no-new-privileges:true"]

  grafana:
    image: {{ supervision_images.grafana }}
    restart: unless-stopped
    ports: ["3001:3000"]   # proxy interne de svc01 uniquement (VPN)
    environment:
      GF_SERVER_ROOT_URL: "{{ supervision_grafana_url }}"
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin
      GF_SECURITY_COOKIE_SECURE: "true"
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_SNAPSHOTS_EXTERNAL_ENABLED: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      # Connexion uniquement par le SSO ; consultation seule, administration pour le groupe admins.
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
      GF_AUTH_OAUTH_AUTO_LOGIN: "true"
      GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
      GF_AUTH_GENERIC_OAUTH_NAME: Authelia
      GF_AUTH_GENERIC_OAUTH_CLIENT_ID: grafana
      GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET__FILE: /run/secrets/grafana_oidc
      GF_AUTH_GENERIC_OAUTH_SCOPES: "openid profile email groups"
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: "{{ supervision_issuer }}/api/oidc/authorization"
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: "{{ supervision_issuer }}/api/oidc/token"
      GF_AUTH_GENERIC_OAUTH_API_URL: "{{ supervision_issuer }}/api/oidc/userinfo"
      GF_AUTH_GENERIC_OAUTH_AUTH_STYLE: InParams
      GF_AUTH_GENERIC_OAUTH_USE_PKCE: "true"
      GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP: "true"
      GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH: preferred_username
      GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH: name
      GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH: groups
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "contains(groups[*], 'admins') && 'Admin' || 'Viewer'"
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT: "true"
      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /var/lib/grafana/tableaux/noc.json
{% if supervision_journaux | bool %}
      # Source de données des journaux (VictoriaLogs) : installée avant le démarrage, version figée.
      GF_PLUGINS_PREINSTALL_SYNC: "{{ supervision_grafana_plugin_journaux }}"
      GF_PLUGINS_PREINSTALL_AUTO_UPDATE: "false"
{% endif %}
    secrets: [grafana_admin, grafana_oidc]
    volumes:
      - grafana:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/tableaux:/var/lib/grafana/tableaux:ro
    security_opt: ["no-new-privileges:true"]

  # NOC public : page sur mesure (nginx sans privilèges) et collecteur qui produit son instantané JSON.
  noc:
    image: {{ supervision_images.noc_web }}
    restart: unless-stopped
    ports: ["3000:8080"]   # publié par le WAF uniquement, qui impose le SSO
    volumes:
      - ./noc/site:/usr/share/nginx/html:ro
      - ./noc/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./noc/etat:/donnees:ro
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]

  noc-collecte:
    image: {{ supervision_images.noc_collecte }}
    restart: unless-stopped
    command: ["python3", "-u", "/app/collecte.py"]
    user: "65534:65534"
    environment:
      PROMETHEUS: http://prometheus:9090
      ALERTMANAGER: http://alertmanager:9093
      TZ: Europe/Paris
    volumes:
      - ./noc/collecte.py:/app/collecte.py:ro
      - ./noc/noc.json:/etc/noc/noc.json:ro
      - ./noc/etat:/sortie
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]

  # Relais des notifications sur téléphone (files/ntfy/relais.py) : mise en forme ici plutôt que par le modèle de
  # ntfy (délai de 100 ms parfois dépassé), plusieurs essais. Joint par Alertmanager seulement, port non publié.
  ntfy-relais:
    image: {{ supervision_images.sms }}
    restart: unless-stopped
    command: ["python3", "-u", "/app/relais.py"]
    user: "65534:65534"
    environment:
      NTFY_URL: http://ntfy
      SUJET: "{{ supervision_ntfy_sujet }}"
      LIEN: "{{ supervision_noc_url }}"
      FICHIER_MOT_DE_PASSE: /run/secrets/ntfy
      PYTHONDONTWRITEBYTECODE: "1"
    volumes:
      - ./ntfy-relais/relais.py:/app/relais.py:ro
      - ./alertmanager/secrets/ntfy:/run/secrets/ntfy:ro
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]

{% if supervision_sms_free.cle is defined %}
  # Relais SMS des alertes critiques (Free Mobile) : joint par Alertmanager seulement, port non publié.
  sms:
    image: {{ supervision_images.sms }}
    restart: unless-stopped
    command: ["python3", "-u", "/app/relais.py"]
    user: "65534:65534"
    environment:
      FICHIER_UTILISATEUR: /run/secrets/sms_utilisateur
      FICHIER_CLE: /run/secrets/sms_cle
      PYTHONDONTWRITEBYTECODE: "1"
    volumes:
      - ./sms/relais.py:/app/relais.py:ro
      - ./secrets/sms_utilisateur:/run/secrets/sms_utilisateur:ro
      - ./secrets/sms_cle:/run/secrets/sms_cle:ro
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]

{% endif %}
{% if supervision_journaux | bool and supervision_detection | bool %}
  # Détection d'intrusion sur les journaux (ADR 0021) : règles LogsQL évaluées chaque minute, alertes vers
  # Alertmanager. Aucun port publié.
  vmalert:
    image: {{ supervision_images.vmalert }}
    restart: unless-stopped
    command:
      - -rule=/etc/vmalert/detection.yml
      - -rule.defaultRuleType=vlogs
      - -datasource.url=http://victorialogs:9428
      - -notifier.url=http://alertmanager:9093
      - -evaluationInterval=1m
      - -external.url={{ supervision_grafana_url }}
    volumes:
      - ./detection/detection.yml:/etc/vmalert/detection.yml:ro
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]

{% endif %}
{% if supervision_veille | bool %}
  # Veille de sécurité (files/veille) : image construite sur place (Trivy + script) ; métriques lues par Prometheus
  # sur le réseau de la pile, aucun port publié. Seul dossier modifiable : ses données (cache, rapport).
  veille:
    image: {{ supervision_veille_image }}
    pull_policy: never
    restart: unless-stopped
    user: "65534:65534"
    environment:
      TZ: Europe/Paris
      VEILLE_HEURE: "{{ supervision_veille_heure }}"
      VEILLE_CA: /etc/veille/autorites.pem
      TMPDIR: /donnees/tmp
    volumes:
      - ./veille/veille.json:/etc/veille/veille.json:ro
      - ./autorites.pem:/etc/veille/autorites.pem:ro
      - ./veille/donnees:/donnees
{% if supervision_veille_jeton_github | length > 0 %}
      - ./secrets/github_veille:/run/secrets/github:ro
{% endif %}
    read_only: true
    mem_limit: {{ supervision_veille_memoire }}
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]

{% endif %}
{% if supervision_connexions | bool %}
  # Veille des connexions : lit les journaux (VictoriaLogs), envoie ses alertes à Alertmanager, expose ses mesures
  # sur 9801 au réseau de la pile seulement. Seul dossier modifiable : son état (adresses connues).
  connexions:
    image: {{ supervision_images.noc_collecte }}
    restart: unless-stopped
    command: ["python3", "-u", "/app/veille-connexions.py"]
    user: "65534:65534"
    environment:
      VICTORIALOGS: http://victorialogs:9428
      ALERTMANAGER: http://alertmanager:9093
      CONFIG: /etc/connexions/connexions.json
      ETAT: /etat/etat.json
      TZ: Europe/Paris
    volumes:
      - ./connexions/veille-connexions.py:/app/veille-connexions.py:ro
      - ./connexions/connexions.json:/etc/connexions/connexions.json:ro
      - ./connexions/etat:/etat
    read_only: true
    mem_limit: 128m
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]

{% endif %}
{% if supervision_journaux | bool %}
  # Journaux centralisés (ADR 0020). Port HTTP non publié : lecture par Grafana, ou par le relais ci-dessous.
  victorialogs:
    image: {{ supervision_images.victorialogs }}
    restart: unless-stopped
    command:
      - -storageDataPath=/victoria-logs-data
      - -retentionPeriod={{ supervision_journaux_retention }}
      - -retention.maxDiskSpaceUsageBytes={{ supervision_journaux_espace_max }}
      - -syslog.listenAddr.tcp=:{{ supervision_journaux_syslog_port }}
      - -syslog.timezone=Europe/Paris
    ports: ["{{ supervision_journaux_syslog_port }}:{{ supervision_journaux_syslog_port }}"]   # syslog du pare-feu (écriture seule)
    volumes:
      - victorialogs:/victoria-logs-data
    security_opt: ["no-new-privileges:true"]

  # Entrée des journaux des machines (systemd-journal-upload) : écriture seule, toute lecture est refusée.
  journaux-entree:
    image: {{ supervision_images.noc_web }}
    restart: unless-stopped
    depends_on: [victorialogs]
    ports:
      - "{{ supervision_journaux_port }}:8080"
{% if supervision_journaux_lecture_sources | length > 0 %}
      - "{{ supervision_journaux_lecture_port }}:8081"   # lecture seule, proxy interne uniquement (SSO admins)
{% endif %}
    volumes:
      - ./journaux/entree.conf:/etc/nginx/conf.d/default.conf:ro
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]

{% endif %}
  ntfy:
    image: {{ supervision_images.ntfy }}
    restart: unless-stopped
    command: ["serve"]
    ports: ["8080:80"]   # publié par le WAF uniquement
    volumes:
      - ./ntfy.yml:/etc/ntfy/server.yml:ro
      - ntfy-cache:/var/cache/ntfy
      - ntfy-auth:/var/lib/ntfy
    security_opt: ["no-new-privileges:true"]

secrets:
  grafana_admin:
    file: ./secrets/grafana_admin
  grafana_oidc:
    file: ./secrets/grafana_oidc

volumes:
  prometheus:
  alertmanager:
  grafana:
  ntfy-cache:
  ntfy-auth:
{% if supervision_journaux | bool %}
  victorialogs:
{% endif %}
